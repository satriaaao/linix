{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/cms",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/cms/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/driver",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/qr-code",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/signage",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/display",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/products-png-20261001/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/product-thumbs-20261002/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/seo",
      "destination": "/api/site?kind=seo"
    },
    {
      "source": "/api/analytics-presence",
      "destination": "/api/analytics-event?kind=presence"
    },
    {
      "source": "/display",
      "destination": "/signage-display.html"
    },
    {
      "source": "/signage",
      "destination": "/signage-cms.html"
    },
    {
      "source": "/qr-code",
      "destination": "/qr.html"
    },
    {
      "source": "/cms-admin-v5-20260912.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/cms-admin-v5-20260912.js"
    },
    {
      "source": "/rental-management-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/rental-management-20260913.js"
    },
    {
      "source": "/rental-professional-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/rental-professional-20260913.js"
    },
    {
      "source": "/rental-insights-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@8829fe3c8ca24503c453cc0ead46053b7e96f0b4/bsm-cinemachine/rental-insights-loader-20260916.js"
    },
    {
      "source": "/serial-dispatch-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/serial-dispatch-20260913.js"
    },
    {
      "source": "/site-logo-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/site-logo-20260913.js"
    },
    {
      "source": "/cms-template-settings-20260913.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/cms-template-settings-20260913.js"
    },
    {
      "source": "/home-product-sections-20260912.js",
      "destination": "https://cdn.jsdelivr.net/gh/satriaaao/linix@46bde66fd10ce06d2ba9f0c1af67689bb43c5ba0/bsm-cinemachine/home-product-sections-20260912.js"
    },
    {
      "source": "/website-orders-20260913.js",
      "destination": "/api/website-orders"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/pantau",
      "destination": "/api/pantau"
    },
    {
      "source": "/driver",
      "destination": "/api/driver"
    },
    {
      "source": "/cms",
      "destination": "/api/cms"
    },
    {
      "source": "/cms/:path*",
      "destination": "/api/cms"
    },
    {
      "source": "/",
      "destination": "/api/site?kind=home"
    },
    {
      "source": "/produk",
      "destination": "/api/site?kind=products"
    },
    {
      "source": "/produk/:slug",
      "destination": "/api/site?kind=product&slug=:slug"
    },
    {
      "source": "/portfolio",
      "destination": "/api/site?kind=portfolio"
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/api/site?kind=portfolioItem&slug=:slug"
    },
    {
      "source": "/artikel",
      "destination": "/api/site?kind=articles"
    },
    {
      "source": "/artikel/:slug",
      "destination": "/api/site?kind=article&slug=:slug"
    },
    {
      "source": "/cart",
      "destination": "/api/site?kind=cart"
    },
    {
      "source": "/cek-order",
      "destination": "/api/site?kind=tracking"
    },
    {
      "source": "/pesanan",
      "destination": "/api/site?kind=order"
    },
    {
      "source": "/:path*",
      "destination": "/api/not-found"
    }
  ],
  "redirects": [
    {
      "source": "/qr",
      "destination": "/qr-code",
      "permanent": true
    },
    {
      "source": "/qr.html",
      "destination": "/qr-code",
      "permanent": true
    }
  ],
  "functions": {
    "api/cms-ui.js": {
      "includeFiles": "{cms-admin-all-tables-adapter-20260918.js,website-design-lib-20260930.js}"
    },
    "api/site.js": {
      "includeFiles": "{index.html,404.html}"
    },
    "api/not-found.js": {
      "includeFiles": "404.html"
    }
  }
}
